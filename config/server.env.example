# Claude Mobile Approver Server Configuration
# Copy this file to server.env and fill in your values

# ntfy server address (internal, since approval server runs on same host)
NTFY_SERVER=http://localhost:2586

# ntfy authentication
NTFY_USER=claude
NTFY_PASS=YOUR_STRONG_PASSWORD_HERE

# ntfy topic for notifications
NTFY_TOPIC=claude-approve

# Directory for storing approval requests
APPROVAL_DIR=/opt/claude-approver/approvals

# Approval server port
PORT=2587
